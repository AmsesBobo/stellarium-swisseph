cmake_minimum_required(VERSION 3.18)
if(NOT BACKEND_ENABLED)
    message("SWISS_TEST_SKIP: requires ENABLE_SWISSEPH=ON")
    return()
endif()
if(IS_GUI AND NOT GUI_ENABLED)
    message("SWISS_TEST_SKIP: requires ENABLE_SWISSEPH_GUI_TESTS=ON and an OpenGL display")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SwissTestData.cmake")
swiss_validate_test_data("${EPHE_PATH}" "${LOCK_FILE}" missing invalid)
if(invalid)
    message(FATAL_ERROR "Invalid Swiss test data: ${invalid}")
endif()
if(missing)
    if(STRICT)
        message(FATAL_ERROR "Missing Swiss test data: ${missing}")
    endif()
    message("SWISS_TEST_SKIP: missing fixtures: ${missing}. Run util/prepare_swisseph_tests.py; see doc/swisseph-prototype.md")
    return()
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "SWEPH_PATH=${EPHE_PATH}" "SE_EPHE_PATH=" "SWEPH_EXACT=0"
                "${PROGRAM}" ${ARGUMENTS} RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Swiss test failed: ${result}")
endif()
