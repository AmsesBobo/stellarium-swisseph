# Swiss-specific tests, including the feature-disabled contract in ordinary builds.
set(SWISSEPH_TEST_EPHE_PATH "${PROJECT_BINARY_DIR}/test-data/swiss" CACHE PATH "Dedicated checksum-pinned Swiss fixture directory")
option(SWISSEPH_REQUIRE_TEST_DATA "Fail configuration/tests if Swiss fixtures are unavailable (CI)" OFF)
option(ENABLE_SWISSEPH_GUI_TESTS "Build and run Swiss tests requiring an OpenGL display" OFF)
set(swiss_fixture_lock "${PROJECT_SOURCE_DIR}/src/tests/swiss-fixtures.lock")
if(SWISSEPH_REQUIRE_TEST_DATA)
    if(NOT ENABLE_SWISSEPH)
        message(FATAL_ERROR "SWISSEPH_REQUIRE_TEST_DATA requires ENABLE_SWISSEPH")
    endif()
    include("${PROJECT_SOURCE_DIR}/cmake/SwissTestData.cmake")
    swiss_validate_test_data("${SWISSEPH_TEST_EPHE_PATH}" "${swiss_fixture_lock}" missing invalid)
    if(missing OR invalid)
        message(FATAL_ERROR "Swiss fixture validation failed. Missing: ${missing}. Invalid: ${invalid}. See util/prepare_swisseph_tests.py")
    endif()
endif()

add_executable(testSwissDisabled tests/testSwissDisabled.cpp)
add_test(NAME swissDisabled COMMAND testSwissDisabled)
add_executable(testSwissManifest tests/testSwissManifest.cpp)
target_link_libraries(testSwissManifest PRIVATE Qt${QT_VERSION_MAJOR}::Core)
add_test(NAME swissManifest COMMAND testSwissManifest)
add_executable(testSwissEphemerisFiles tests/testSwissEphemerisFiles.cpp)
target_link_libraries(testSwissEphemerisFiles PRIVATE Qt${QT_VERSION_MAJOR}::Core)
add_test(NAME swissDownloadValidation COMMAND testSwissEphemerisFiles)
find_package(Python3 QUIET COMPONENTS Interpreter)
if(Python3_Interpreter_FOUND)
    add_test(NAME swissFixturePreparation COMMAND "${CMAKE_COMMAND}" -E env "PYTHONDONTWRITEBYTECODE=1"
        "${Python3_EXECUTABLE}" -m unittest discover -s "${PROJECT_SOURCE_DIR}/util" -p test_prepare_swisseph_tests.py)
else()
    add_test(NAME swissFixturePreparation COMMAND "${CMAKE_COMMAND}" -E echo "SWISS_TEST_SKIP: fixture preparation tests require Python3")
    set_tests_properties(swissFixturePreparation PROPERTIES SKIP_REGULAR_EXPRESSION "SWISS_TEST_SKIP:")
endif()
add_custom_target(buildSwissTests DEPENDS testSwissDisabled testSwissManifest testSwissEphemerisFiles)

if(ENABLE_SWISSEPH)
    foreach(test IN ITEMS Paths Deletion Interpolation Ephemeris)
        add_executable(testSwiss${test} tests/testSwiss${test}.cpp core/planetsephems/SwissEphemeris.cpp)
        target_link_libraries(testSwiss${test} PRIVATE stellarium_swe Qt${QT_VERSION_MAJOR}::Core)
        add_dependencies(buildSwissTests testSwiss${test})
    endforeach()
    foreach(test IN ITEMS PlanetCache AstroCalc)
        add_executable(testSwiss${test} EXCLUDE_FROM_ALL tests/testSwiss${test}.cpp)
        target_link_libraries(testSwiss${test} PRIVATE ${winMMLib} ${STELMAIN_DEPS} stelMain)
        set_target_properties(testSwiss${test} PROPERTIES ENABLE_EXPORTS TRUE)
        add_dependencies(testSwiss${test} AllStaticPlugins)
        if(ENABLE_SWISSEPH_GUI_TESTS)
            set_target_properties(testSwiss${test} PROPERTIES EXCLUDE_FROM_ALL FALSE)
            add_dependencies(buildSwissTests testSwiss${test})
        endif()
    endforeach()
    if(USE_PLUGIN_SOLARSYSTEMEDITOR)
        target_compile_definitions(testSwissPlanetCache PRIVATE TEST_SWISS_DOWNLOADER)
    endif()
    add_test(NAME swissNoConfiguredPath COMMAND ${CMAKE_COMMAND} -E env "SWEPH_PATH=" $<TARGET_FILE:testSwissEphemeris> --unavailable)
    add_test(NAME swissMissingFiles COMMAND ${CMAKE_COMMAND} -E env "SWEPH_PATH=${PROJECT_BINARY_DIR}/nonexistent-ephemeris" $<TARGET_FILE:testSwissEphemeris> --unavailable)
else()
    foreach(name IN ITEMS swissNoConfiguredPath swissMissingFiles)
        add_test(NAME ${name} COMMAND ${CMAKE_COMMAND} -E echo "SWISS_TEST_SKIP: requires ENABLE_SWISSEPH=ON")
        set_tests_properties(${name} PROPERTIES SKIP_REGULAR_EXPRESSION "SWISS_TEST_SKIP:")
    endforeach()
endif()

function(swiss_data_test name target gui)
    set(program "")
    if(TARGET ${target})
        set(program "$<TARGET_FILE:${target}>")
    endif()
    add_test(NAME ${name} COMMAND ${CMAKE_COMMAND}
        "-DBACKEND_ENABLED=${ENABLE_SWISSEPH}" "-DGUI_ENABLED=${ENABLE_SWISSEPH_GUI_TESTS}" "-DIS_GUI=${gui}"
        "-DSTRICT=${SWISSEPH_REQUIRE_TEST_DATA}" "-DEPHE_PATH=${SWISSEPH_TEST_EPHE_PATH}" "-DLOCK_FILE=${swiss_fixture_lock}"
        "-DPROGRAM=${program}" "-DARGUMENTS=${ARGN}" -P "${PROJECT_SOURCE_DIR}/cmake/RunSwissTest.cmake")
    set_tests_properties(${name} PROPERTIES WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
        SKIP_REGULAR_EXPRESSION "SWISS_TEST_SKIP:" LABELS "swiss;external-data" TIMEOUT 180)
    if(gui)
        set_tests_properties(${name} PROPERTIES LABELS "swiss;external-data;integration;gui")
    endif()
endfunction()
swiss_data_test(swissEphemeris testSwissEphemeris FALSE)
swiss_data_test(swissIndividualAsteroids testSwissEphemeris FALSE --extended)
swiss_data_test(swissInterpolation testSwissInterpolation FALSE)
swiss_data_test(swissDeletion testSwissDeletion FALSE "${SWISSEPH_TEST_EPHE_PATH}")
swiss_data_test(swissPaths testSwissPaths FALSE "${SWISSEPH_TEST_EPHE_PATH}")
swiss_data_test(swissPlanetCache testSwissPlanetCache TRUE "${SWISSEPH_TEST_EPHE_PATH}")
swiss_data_test(swissAstroCalc testSwissAstroCalc TRUE "${SWISSEPH_TEST_EPHE_PATH}")
message(STATUS "Swiss tests: backend=${ENABLE_SWISSEPH}, GUI=${ENABLE_SWISSEPH_GUI_TESTS}, strict fixtures=${SWISSEPH_REQUIRE_TEST_DATA}")
message(STATUS "Swiss fixture directory: ${SWISSEPH_TEST_EPHE_PATH}; skipped tests are reported explicitly by CTest")
