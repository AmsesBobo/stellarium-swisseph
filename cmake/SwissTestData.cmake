# Shared validation for configure-time CI checks and runtime CTest checks.
function(swiss_validate_test_data directory lock_file out_missing out_invalid)
    file(STRINGS "${lock_file}" rows REGEX "^[^#]")
    set(expected)
    set(missing)
    set(invalid)
    foreach(row IN LISTS rows)
        string(REPLACE "|" ";" fields "${row}")
        list(GET fields 0 name)
        list(GET fields 1 size)
        list(GET fields 2 digest)
        list(APPEND expected "${name}")
        if(NOT EXISTS "${directory}/${name}")
            list(APPEND missing "${name}")
        else()
            file(SIZE "${directory}/${name}" actual_size)
            file(SHA256 "${directory}/${name}" actual_digest)
            if(NOT actual_size EQUAL size OR NOT actual_digest STREQUAL digest)
                list(APPEND invalid "${name} (size/SHA-256 mismatch)")
            endif()
        endif()
    endforeach()
    file(GLOB_RECURSE present RELATIVE "${directory}" "${directory}/*.se1")
    foreach(name IN LISTS present)
        if(NOT name IN_LIST expected)
            list(APPEND invalid "${name} (unexpected fixture; use a dedicated test directory)")
        endif()
    endforeach()
    set(${out_missing} "${missing}" PARENT_SCOPE)
    set(${out_invalid} "${invalid}" PARENT_SCOPE)
endfunction()
